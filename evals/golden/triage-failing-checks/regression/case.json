  "script": "triage_checks.py",
  "args": ["--cmd", "python3 check.py", "--base", "main", "--no-state", "--json"],
  "cwd": "fixture",
  "expect_exit": 1,
  "setup": [
    ["git", "init", "-q", "-b", "main"],
