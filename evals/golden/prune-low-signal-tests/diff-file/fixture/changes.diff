+import unittest
+
+from invoice import render
+
+
+class TestInvoice(unittest.TestCase):
+    def test_lists_each_line(self):
+        self.assertIn("2 x widget", render([("widget", 2)]))
+
+    def test_never_shows_card_number(self):
+        self.assertNotIn("4242", render([("widget", 1)], card="4242424242424242"))
